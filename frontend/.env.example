# Supabase Configuration (Public - safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Configuration (Secret - server-side only)
# Keep this secure and never expose to client-side code
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Legacy API URL (if still using separate FastAPI backend)
NEXT_PUBLIC_API_URL=http://localhost:8000
